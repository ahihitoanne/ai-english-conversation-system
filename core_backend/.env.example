# App Configuration
APP_NAME=VocabTalk-API
DEBUG=True
API_V1_PREFIX=/api/v1

# PostgreSQL Connection String
# Dùng với Docker Compose local:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/vocabtalk
# Hoặc dùng Cloud PostgreSQL (Supabase / Neon):
# DATABASE_URL=postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# AI Services API Keys (Cần điền key thật khi chạy)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Security
SECRET_KEY=change_this_to_a_random_32_char_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (Frontend Next.js mặc định chạy port 3000)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
